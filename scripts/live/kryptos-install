#!/usr/bin/env bash
# Install KryptOS live ISO to a VM disk. Destructive by design.
# UEFI booted live ISO -> GPT + ESP + x86_64-efi GRUB.
# BIOS booted live ISO -> DOS MBR + i386-pc GRUB fallback.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

usage() {
    cat <<'EOF'
usage: kryptos-install --yes /dev/sdX [--uefi|--bios] [--gpu auto|amd|intel|both]

WARNING: destroys the target disk. Hyper-V target is often /dev/sda.
Check disks first with: cat /proc/partitions

Mode defaults from current boot:
  /sys/firmware/efi present -> UEFI/GPT
  otherwise                 -> BIOS/MBR

GPU firmware defaults to auto: the installer reads the graphics device it is
running on and keeps only that vendor's firmware. Both driver stacks stay
installed either way, so this only affects disk usage.
  auto   keep the detected vendor's firmware (both when none is detected)
  amd    amdgpu
  intel  i915
  both   keep both sets
EOF
}

YES=""
DISK=""
MODE=auto
GPU=auto
EXTRA=""
while [ $# -gt 0 ]; do
    case "$1" in
        --gpu)
            [ $# -ge 2 ] || { echo "--gpu needs a value: auto|amd|intel|both" >&2; exit 2; }
            GPU="$2"; shift 2 ;;
        --gpu=*)
            GPU="${1#--gpu=}"; shift ;;
        --uefi|--bios)
            MODE="$1"; shift ;;
        *)
            if [ -z "$YES" ]; then YES="$1"
            elif [ -z "$DISK" ]; then DISK="$1"
            else EXTRA="$1"
            fi
            shift ;;
    esac
done
case "$GPU" in
    auto|amd|intel|both) ;;
    *) echo "refusing unknown --gpu value: $GPU (auto|amd|intel|both)" >&2; exit 2 ;;
esac
[ "$YES" = "--yes" ] || { usage; exit 2; }
[ -z "$EXTRA" ] || { usage; exit 2; }
[ -n "$DISK" ] || { usage; exit 2; }
[ -b "$DISK" ] || { echo "target is not a block device: $DISK" >&2; exit 1; }
case "$DISK" in
    /dev/sd[a-z]|/dev/vd[a-z]|/dev/hd[a-z]) ;;
    *) echo "refusing unusual target disk: $DISK" >&2; exit 1 ;;
esac
case "$MODE" in
    auto|--uefi|--bios) ;;
    *) usage; exit 2 ;;
esac
if [ "$MODE" = auto ]; then
    if [ -d /sys/firmware/efi ]; then MODE=--uefi; else MODE=--bios; fi
fi

ROOT_PART="${DISK}1"
ESP_PART=""
MNT=/mnt/target

need() {
    case "$1" in
        /*) [ -x "$1" ] || { echo "missing required tool: $1" >&2; exit 1; } ;;
        *) command -v "$1" >/dev/null || { echo "missing required tool: $1 (PATH=$PATH)" >&2; exit 1; } ;;
    esac
}
cleanup_mounts() {
    for fs in run sys proc dev; do umount "$MNT/$fs" 2>/dev/null || true; done
    umount "$MNT/boot/efi" 2>/dev/null || true
    umount "$MNT" 2>/dev/null || true
}
trap cleanup_mounts EXIT

need sfdisk
need blockdev
need mkfs.ext4
need blkid
need tar
need gzip

if [ "$MODE" = "--uefi" ]; then
    need mkfs.fat
    need /usr/bin/grub-mkimage
    ESP_PART="${DISK}1"
    ROOT_PART="${DISK}2"
else
    need /usr/sbin/grub-install
fi

printf 'KryptOS install target: %s\n' "$DISK"
printf 'Install mode: %s\n' "${MODE#--}"
echo "This will erase $DISK in 5 seconds. Ctrl-C to abort."
sleep 5

swapoff -a 2>/dev/null || true
cleanup_mounts
mkdir -p "$MNT"

if command -v wipefs >/dev/null 2>&1; then
    echo "[install] wipe old signatures"
    wipefs -a "$DISK" 2>/dev/null || true
fi

if [ "$MODE" = "--uefi" ]; then
    echo "[install] partition $DISK as GPT (ESP + root)"
    sfdisk "$DISK" <<'SFDISK'
label: gpt
,512M,U,*
,,L
SFDISK
else
    echo "[install] partition $DISK as BIOS/MBR (root)"
    sfdisk "$DISK" <<'SFDISK'
label: dos
,,83,*
SFDISK
fi
blockdev --rereadpt "$DISK" 2>/dev/null || true
sleep 2
[ -b "$ROOT_PART" ] || { echo "root partition missing: $ROOT_PART" >&2; exit 1; }
[ -z "$ESP_PART" ] || [ -b "$ESP_PART" ] || { echo "ESP missing: $ESP_PART" >&2; exit 1; }

if [ "$MODE" = "--uefi" ]; then
    echo "[install] format ESP $ESP_PART"
    mkfs.fat -F 32 -n KRYPTOS_EFI "$ESP_PART"
fi

echo "[install] format root $ROOT_PART"
mkfs.ext4 -F -L KRYPTOS "$ROOT_PART"

echo "[install] mount target"
mount "$ROOT_PART" "$MNT"
if [ "$MODE" = "--uefi" ]; then
    mkdir -p "$MNT/boot/efi"
    mount "$ESP_PART" "$MNT/boot/efi"
fi

ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"
[ -n "$ROOT_UUID" ] || { echo "failed to read UUID for $ROOT_PART" >&2; exit 1; }
ROOT_PARTUUID="$(blkid -s PARTUUID -o value "$ROOT_PART")"
[ -n "$ROOT_PARTUUID" ] || { echo "failed to read PARTUUID for $ROOT_PART" >&2; exit 1; }
ESP_UUID=""
if [ "$MODE" = "--uefi" ]; then
    ESP_UUID="$(blkid -s UUID -o value "$ESP_PART")"
    [ -n "$ESP_UUID" ] || { echo "failed to read UUID for $ESP_PART" >&2; exit 1; }
fi

INSTALL_ROOTFS=/media/kryptos-live/kryptos/rootfs.tar.gz
[ -r "$INSTALL_ROOTFS" ] || { echo "immutable installer payload unavailable: $INSTALL_ROOTFS" >&2; exit 1; }
echo "[install] copy immutable ISO rootfs"
gzip -dc "$INSTALL_ROOTFS" | \
    tar --xattrs --acls --numeric-owner --warning=no-timestamp -xpf - -C "$MNT"

# Both GPU vendors ship in the image so the ISO boots anywhere. Trim the one
# this machine will never load; the drivers themselves stay installed.
detect_gpu() {
    local card vendor
    for card in /sys/class/drm/card[0-9]*; do
        [ -r "$card/device/vendor" ] || continue
        vendor="$(cat "$card/device/vendor" 2>/dev/null)"
        case "$vendor" in
            0x1002) echo amd; return 0 ;;
            0x8086) echo intel; return 0 ;;
        esac
    done
    echo unknown
}
GPU_CHOICE="$GPU"
if [ "$GPU_CHOICE" = auto ]; then
    GPU_CHOICE="$(detect_gpu)"
    case "$GPU_CHOICE" in
        amd|intel) echo "[install] detected $GPU_CHOICE graphics; keeping its firmware" ;;
        *) GPU_CHOICE=both
           echo "[install] no AMD/Intel GPU detected; keeping both firmware sets" ;;
    esac
fi
FW_ROOT="$MNT/usr/lib/firmware"
[ -d "$FW_ROOT" ] || FW_ROOT=""
case "$GPU_CHOICE" in
    amd)   [ -z "$FW_ROOT" ] || rm -rf "$FW_ROOT/i915" ;;
    intel) [ -z "$FW_ROOT" ] || rm -rf "$FW_ROOT/amdgpu" ;;
esac
if [ -n "$FW_ROOT" ]; then
    printf '%s\n' "$GPU_CHOICE" > "$MNT/etc/kryptos-gpu"
    du -sh "$FW_ROOT"/* 2>/dev/null | sed 's|^|[install] firmware |' || true
fi

mkdir -p "$MNT"/{dev,proc,sys,run,tmp,boot,mnt,media}
[ "$MODE" = "--uefi" ] && mkdir -p "$MNT/boot/efi"
chmod 1777 "$MNT/tmp"
cat > "$MNT/etc/fstab" <<EOF
UUID=$ROOT_UUID / ext4 defaults 1 1
EOF
if [ "$MODE" = "--uefi" ]; then
    cat >> "$MNT/etc/fstab" <<EOF
UUID=$ESP_UUID /boot/efi vfat umask=0077 0 1
EOF
fi
cat >> "$MNT/etc/fstab" <<'EOF'
proc /proc proc defaults 0 0
sysfs /sys sysfs defaults 0 0
devtmpfs /dev devtmpfs mode=0755,nosuid 0 0
tmpfs /run tmpfs defaults 0 0
tmpfs /dev/shm tmpfs defaults 0 0
cgroup2 /sys/fs/cgroup cgroup2 defaults 0 0
tmpfs /tmp tmpfs mode=1777 0 0
EOF

KERNEL="$(basename "$(ls "$MNT"/boot/vmlinuz-* | sort | tail -1)")"
[ -n "$KERNEL" ] || { echo "missing installed kernel" >&2; exit 1; }
mkdir -p "$MNT/boot/grub"
write_grub_cfg() {
    cat > "$MNT/boot/grub/grub.cfg" <<EOF
set timeout=3
set default=0

search --fs-uuid --set=root $ROOT_UUID

menuentry "KryptOS" {
    search --fs-uuid --set=root $ROOT_UUID
    linux /boot/$KERNEL root=PARTUUID=$ROOT_PARTUUID rw console=tty0 net.ifnames=0
}
EOF
    if [ "$MODE" = "--uefi" ]; then
        mkdir -p "$MNT/boot/efi/boot/grub" "$MNT/boot/efi/EFI/BOOT"
        cp "$MNT/boot/grub/grub.cfg" "$MNT/boot/efi/boot/grub/grub.cfg"
        cat > "$MNT/boot/efi/EFI/BOOT/grub.cfg" <<EOF
search --fs-uuid --set=root $ROOT_UUID
configfile /boot/grub/grub.cfg
EOF
    fi
}
write_grub_cfg

write_efi_fallback() {
    [ "$MODE" = "--uefi" ] || return 0
    echo "[install] build standalone UEFI fallback loader"
    mkdir -p "$MNT/boot/efi/EFI/BOOT"
    cat > "$MNT/tmp/kryptos-disk-grub.cfg" <<EOF
search --fs-uuid --set=root $ROOT_UUID
set prefix=(\$root)/boot/grub
linux /boot/$KERNEL root=PARTUUID=$ROOT_PARTUUID rw console=tty0 net.ifnames=0
boot
EOF
    /usr/bin/grub-mkimage \
        -d /usr/lib/grub/x86_64-efi \
        -O x86_64-efi \
        -o "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" \
        -p /boot/grub -c "$MNT/tmp/kryptos-disk-grub.cfg" \
        normal linux search search_fs_uuid part_gpt fat ext2
    [ -s "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" ] || { echo "UEFI fallback loader was not written" >&2; exit 1; }
}

if [ "$MODE" = "--uefi" ]; then
    echo "[install] install deterministic UEFI fallback loader"
    write_efi_fallback
else
    echo "[install] bind mount kernel filesystems"
    for fs in dev proc sys run; do mount --bind "/$fs" "$MNT/$fs"; done
    echo "[install] install BIOS GRUB to $DISK"
    chroot "$MNT" /usr/sbin/grub-install --target=i386-pc "$DISK"
fi
write_grub_cfg
sync
if [ "$MODE" = "--uefi" ]; then
    echo "[install] verified EFI/BOOT/BOOTX64.EFI"
fi

echo "[install] GPU firmware kept: $GPU_CHOICE"
echo "[install] done. Shut down, remove ISO, boot from disk."