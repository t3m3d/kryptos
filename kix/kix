#!/usr/bin/env bash
# kix — KryptOS package manager (v0 shell engine).
#
# HYBRID delivery: an install prefers a prebuilt binary package (.kpkg) from the
# binary repo and falls back to building the source recipe when no binary matches
# the recipe's version. DEPENDENCY-AWARE: recipes declare depends=(...); kix walks
# the graph, installs deps first, and blocks removal of a package others need.
#
# Recipes are a constrained subset that is ALSO valid bash (arrays included), so
# this shell engine just `source`s them today and a future Krypton-written engine
# can parse the same files. Keep that contract: a recipe sets name/version/source/
# sha256/depends and a build() that calls only `run`.
#
# Requires bash 4+ (associative arrays) — present on KryptOS (bash 5.2).
set -euo pipefail

# --- config (override via env) -------------------------------------------------
KIX_ROOT="${KIX_ROOT:-/var/lib/kix}"
KIX_TREE="${KIX_TREE:-$KIX_ROOT/tree}"          # recipe tree (git checkout)
KIX_DB="${KIX_DB:-$KIX_ROOT/db}"                # installed-package manifests
KIX_CACHE="${KIX_CACHE:-/var/cache/kix/src}"    # downloaded source tarballs
KIX_BINCACHE="${KIX_BINCACHE:-/var/cache/kix/bin}"  # downloaded .kpkg binaries
KIX_WORK="${KIX_WORK:-/tmp/kix-build}"          # scratch build dir
KIX_TREE_URL="${KIX_TREE_URL:-https://github.com/t3m3d/kix-tree.git}"
KIX_ARCH="${KIX_ARCH:-$(uname -m)}"
# Binary repo: a dir/URL holding <name>-<version>.kpkg files + an 'index' file
# (lines: "<name> <version> <sha256> <filename>"). Empty = source-only mode.
KIX_BINREPO_URL="${KIX_BINREPO_URL:-}"
KIX_INDEX="$KIX_ROOT/index.$KIX_ARCH"
DESTDIR_ROOT="${KIX_INSTALL_ROOT:-/}"

c_msg='\033[1;35m'; c_ok='\033[1;32m'; c_warn='\033[1;33m'; c_err='\033[1;31m'; c_0='\033[0m'
msg()  { printf "${c_msg}[kix]${c_0} %s\n" "$*"; }
ok()   { printf "${c_ok}[kix]${c_0} %s\n" "$*"; }
warn() { printf "${c_warn}[kix:warn]${c_0} %s\n" "$*" >&2; }
die()  { printf "${c_err}[kix:fail]${c_0} %s\n" "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "must run as root (writes $DESTDIR_ROOT)"; }
mkdirs()    { mkdir -p "$KIX_TREE" "$KIX_DB" "$KIX_CACHE" "$KIX_BINCACHE"; }

dl() { # dl <url> <out>  — curl or wget, atomic
    local url="$1" out="$2"
    if command -v curl >/dev/null; then curl -fL --retry 3 -o "$out.part" "$url"
    else wget -O "$out.part" "$url"; fi
    mv "$out.part" "$out"
}
sha_of() { sha256sum "$1" | cut -d' ' -f1; }

# --- recipe sandbox ------------------------------------------------------------
run() { printf '    %s\n' "$*"; eval "$*"; }

recipe_path() {
    local p="$KIX_TREE/$1/recipe.ks"
    [ -f "$p" ] || die "no recipe for '$1' (try: kix sync)"
    printf '%s\n' "$p"
}
# Load a recipe's metadata into the CURRENT shell. Always call inside a subshell
# when you need a clean slate (resolution/queries), so fields never leak.
load_recipe() {
    name=''; version=''; source=''; sha256=''; depends=()
    unset -f build 2>/dev/null || true
    # shellcheck disable=SC1090
    . "$(recipe_path "$1")"
    [ -n "$name" ]    || die "$1: recipe missing name"
    [ -n "$version" ] || die "$1: recipe missing version"
    declare -F build >/dev/null || [ -n "$source" ] || die "$1: recipe needs build() or source"
}
recipe_version() { ( load_recipe "$1"; printf '%s' "$version" ); }
recipe_depends() { ( load_recipe "$1"; printf '%s\n' "${depends[@]:-}" ); }

installed_version() { local v="$KIX_DB/$1/version"; [ -f "$v" ] && cat "$v"; }
is_installed()      { [ -d "$KIX_DB/$1" ]; }

# --- dependency resolution (post-order DFS → deps before dependents) -----------
declare -A _visited
_order=()
_visit() {
    local p="$1" d
    [ -n "${_visited[$p]:-}" ] && return 0
    _visited[$p]=1
    while read -r d; do
        [ -n "$d" ] && _visit "$d"
    done < <(recipe_depends "$p")
    _order+=("$p")
}
resolve() { # resolve <pkg>... → sets _order to full install order
    _visited=(); _order=()
    declare -gA _visited
    local p; for p in "$@"; do _visit "$p"; done
}

# --- binary repo (hybrid) ------------------------------------------------------
bin_lookup() { # bin_lookup <name> <version> → echoes "<sha256> <filename>" if present
    [ -f "$KIX_INDEX" ] || return 1
    awk -v n="$1" -v v="$2" '$1==n && $2==v {print $3, $4; found=1} END{exit !found}' "$KIX_INDEX"
}

# --- acquire into a staging dir ($1=pkg, $2=stagedir) --------------------------
acquire() {
    local pkg="$1" stage="$2" ver bin sha file
    ver=$(recipe_version "$pkg")
    mkdir -p "$stage"

    # 1) try a matching prebuilt binary
    if [ -n "$KIX_BINREPO_URL" ] && bin=$(bin_lookup "$pkg" "$ver"); then
        sha=${bin%% *}; file=${bin##* }
        local kpkg="$KIX_BINCACHE/$file"
        [ -f "$kpkg" ] || { msg "fetch binary $file"; dl "$KIX_BINREPO_URL/$file" "$kpkg"; }
        [ "$(sha_of "$kpkg")" = "$sha" ] || die "$pkg: .kpkg sha256 mismatch"
        msg "unpack binary $pkg-$ver"
        tar -C "$stage" -xf "$kpkg"
        return 0
    fi

    # 2) fall back to building the source recipe
    msg "no binary for $pkg-$ver → building from source"
    ( load_recipe "$pkg"
      [ -n "$source" ] || die "$pkg: no source and no binary"
      local tarball="$KIX_CACHE/$(basename "$source")"
      [ -f "$tarball" ] || { msg "fetch $source"; dl "$source" "$tarball"; }
      if [ -n "$sha256" ]; then
          [ "$(sha_of "$tarball")" = "$sha256" ] || die "$pkg: source sha256 mismatch"
      else warn "$pkg: source has no sha256 pin"; fi
      local sdir="$KIX_WORK/$pkg.src"; rm -rf "$sdir"; mkdir -p "$sdir"
      tar -C "$sdir" -xf "$tarball"
      local srcdir; srcdir=$(find "$sdir" -mindepth 1 -maxdepth 1 -type d | head -1)
      export PKGROOT="$stage"
      ( cd "${srcdir:-$sdir}" && build ) )
}

install_one() {
    local pkg="$1" ver cur
    ver=$(recipe_version "$pkg")
    if cur=$(installed_version "$pkg"); then
        [ "$cur" = "$ver" ] && { ok "$pkg-$ver already installed"; return 0; }
        msg "upgrading $pkg $cur -> $ver"
    fi
    local stage="$KIX_WORK/$pkg.stage"; rm -rf "$stage"
    acquire "$pkg" "$stage"

    local dbdir="$KIX_DB/$pkg"; mkdir -p "$dbdir"
    ( cd "$stage" && find . \( -type f -o -type l \) | sed 's|^\.||' ) > "$dbdir/files"
    printf '%s\n' "$ver" > "$dbdir/version"
    recipe_depends "$pkg" | grep -v '^$' > "$dbdir/depends" || true
    [ -f "$dbdir/reason" ] || echo dep > "$dbdir/reason"

    msg "merge $pkg -> $DESTDIR_ROOT ($(wc -l < "$dbdir/files") files)"
    tar -C "$stage" -cf - . | tar -C "$DESTDIR_ROOT" -xf -
    ok "installed $pkg-$ver"
}

# --- commands ------------------------------------------------------------------
cmd_sync() {
    mkdirs
    if [ -d "$KIX_TREE/.git" ]; then msg "updating recipe tree"; git -C "$KIX_TREE" pull --ff-only
    else msg "cloning recipe tree"; rmdir "$KIX_TREE" 2>/dev/null||true; git clone "$KIX_TREE_URL" "$KIX_TREE"; fi
    if [ -n "$KIX_BINREPO_URL" ]; then
        msg "fetching binary index ($KIX_ARCH)"
        dl "$KIX_BINREPO_URL/index" "$KIX_INDEX" || warn "no binary index — source-only mode"
    fi
    ok "synced"
}

cmd_install() {
    need_root; mkdirs
    [ $# -ge 1 ] || die "usage: kix install <pkg>..."
    resolve "$@"
    msg "install order: ${_order[*]}"
    local p; for p in "${_order[@]}"; do install_one "$p"; done
    for p in "$@"; do echo explicit > "$KIX_DB/$p/reason"; done   # requested = explicit
    ok "done (${#_order[@]} package(s))"
}

revdeps() { # who depends on $1 (installed)?
    local d; for d in "$KIX_DB"/*/; do
        [ -d "$d" ] || continue
        [ -f "$d/depends" ] && grep -qx "$1" "$d/depends" && basename "$d"
    done
}
cmd_remove() {
    need_root
    [ $# -ge 1 ] || die "usage: kix remove <pkg>..."
    local force=0; [ "${1:-}" = "-f" ] && { force=1; shift; }
    for pkg in "$@"; do
        is_installed "$pkg" || { warn "$pkg not installed"; continue; }
        local rd; rd=$(revdeps "$pkg" | tr '\n' ' ')
        if [ -n "$rd" ] && [ "$force" -ne 1 ]; then
            die "$pkg is required by: $rd  (remove those first, or 'kix remove -f')"
        fi
        msg "removing $pkg"
        tac "$KIX_DB/$pkg/files" | while read -r f; do
            [ -n "$f" ] && rm -f "${DESTDIR_ROOT%/}/$f" 2>/dev/null || true
        done
        sed 's|/[^/]*$||' "$KIX_DB/$pkg/files" | sort -ru | while read -r d; do
            rmdir "${DESTDIR_ROOT%/}/$d" 2>/dev/null || true
        done
        rm -rf "$KIX_DB/$pkg"
        ok "removed $pkg"
    done
}

cmd_build() { # build a .kpkg from a source recipe (for the binary repo / farm)
    [ $# -ge 1 ] || die "usage: kix build <pkg> [outdir]"
    mkdirs
    local pkg="$1" out="${2:-$PWD}" ver stage file
    ver=$(recipe_version "$pkg")
    stage="$KIX_WORK/$pkg.stage"; rm -rf "$stage"
    KIX_BINREPO_URL='' acquire "$pkg" "$stage"   # force source build
    mkdir -p "$out"
    file="$pkg-$ver.kpkg"
    tar -C "$stage" -czf "$out/$file" .
    local sha; sha=$(sha_of "$out/$file")
    ok "built $out/$file"
    printf '%s %s %s %s\n' "$pkg" "$ver" "$sha" "$file"   # paste into the repo index
}

cmd_upgrade() {
    need_root; mkdirs
    [ -d "$KIX_DB" ] || { ok "nothing installed"; return; }
    local any=0 d pkg cur new
    for d in "$KIX_DB"/*/; do
        [ -d "$d" ] || continue
        pkg=$(basename "$d"); cur=$(cat "$d/version")
        new=$(recipe_version "$pkg" 2>/dev/null) || { warn "$pkg: no recipe"; continue; }
        [ "$cur" != "$new" ] && { msg "$pkg $cur -> $new"; install_one "$pkg"; any=1; }
    done
    [ "$any" = 1 ] || ok "everything up to date"
}

cmd_search() {
    [ $# -ge 1 ] || die "usage: kix search <term>"
    [ -d "$KIX_TREE" ] || die "no tree (run: kix sync)"
    local d n
    for d in "$KIX_TREE"/*/; do
        n=$(basename "$d"); [ -f "$d/recipe.ks" ] || continue
        printf '%s' "$n" | grep -qi "$1" && printf '%-20s %s\n' "$n" "$(recipe_version "$n" 2>/dev/null||echo '?')"
    done
    return 0
}
cmd_list() {
    [ -d "$KIX_DB" ] || { ok "nothing installed"; return; }
    local d; for d in "$KIX_DB"/*/; do [ -d "$d" ] && printf '%-20s %-12s %s\n' \
        "$(basename "$d")" "$(cat "$d/version")" "$(cat "$d/reason" 2>/dev/null||echo '?')"; done
}
cmd_info() {
    [ $# -ge 1 ] || die "usage: kix info <pkg>"
    ( load_recipe "$1"
      printf 'name      %s\nversion   %s\ndepends   %s\nsource    %s\n' \
        "$name" "$version" "${depends[*]:-none}" "${source:-<binary-only>}"
      if [ -n "$KIX_BINREPO_URL" ] && bin_lookup "$1" "$version" >/dev/null 2>&1; then
          echo "binary    available"; else echo "binary    none (builds from source)"; fi
      if v=$(installed_version "$1"); then echo "installed $v"; else echo "installed no"; fi
      [ -d "$KIX_DB/$1" ] && echo "needed-by $(revdeps "$1" | tr '\n' ' ')" )
}

cmd_qlist()   { [ $# -ge 1 ] || die "usage: kix -Ql <pkg>"; is_installed "$1" || die "$1 not installed"; cat "$KIX_DB/$1/files"; }
cmd_qsearch() {
    local d n; for d in "$KIX_DB"/*/; do [ -d "$d" ] || continue; n=$(basename "$d")
        printf '%s' "$n" | grep -qi "${1:-}" && printf '%-20s %s\n' "$n" "$(cat "$d/version")"; done
    return 0
}

usage() {
    cat <<EOF
kix — KryptOS package manager (pacman-style; hybrid binary/source, dep-aware)

 Sync / install:
  kix -S <pkg>...    install (binary if available, else build from source)
  kix -Sy            refresh recipe tree + binary index
  kix -Su            upgrade installed packages
  kix -Syu           refresh, then full upgrade
  kix -Ss <term>     search recipes
  kix -Si <pkg>      recipe + dep + binary/installed status
 Remove:
  kix -R <pkg>...    remove (blocked if other packages need it)
  kix -Rs <pkg>      force remove despite reverse-deps
 Query (installed):
  kix -Q             list installed (name version reason)
  kix -Qi <pkg>      info on an installed package
  kix -Ql <pkg>      list a package's files
  kix -Qs <term>     search installed
 Build:
  kix -B <pkg> [dir] build a .kpkg from source (for the binary repo)

Hybrid: set KIX_BINREPO_URL to a repo of .kpkg + index for fast binary installs;
unset = pure source mode. Recipes: $KIX_TREE  Binaries: $KIX_BINCACHE
EOF
}

# pacman-style flags: first token is -<OP><mods...>; OP in S/R/Q/B, mods refine.
main() {
    local arg="${1:-}"; shift || true
    case "$arg" in
        -S*)  local m="${arg#-S}"
              case "$m" in
                  *s*) cmd_search "$@";;
                  *i*) cmd_info "$@";;
                  *)   [[ "$m" == *y* ]] && cmd_sync
                       [[ "$m" == *u* ]] && cmd_upgrade
                       [ $# -gt 0 ] && cmd_install "$@"
                       [ -z "$m" ] && [ $# -eq 0 ] && die "kix -S: no targets" || true;;
              esac;;
        -R*)  case "${arg#-R}" in *s*|*f*) cmd_remove -f "$@";; *) cmd_remove "$@";; esac;;
        -Q*)  case "${arg#-Q}" in
                  *l*) cmd_qlist "$@";; *i*) cmd_info "$@";;
                  *s*) cmd_qsearch "$@";; *) cmd_list;;
              esac;;
        -B*)  cmd_build "$@";;
        -h|--help|help|'') usage;;
        # long-form aliases (convenience)
        sync) cmd_sync "$@";; install) cmd_install "$@";; remove) cmd_remove "$@";;
        upgrade) cmd_upgrade "$@";; search) cmd_search "$@";; info) cmd_info "$@";;
        list) cmd_list;; build) cmd_build "$@";;
        *) die "unknown operation: $arg (try: kix -h)";;
    esac
}
main "$@"
