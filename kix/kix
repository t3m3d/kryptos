#!/usr/bin/env bash
# kix — KryptOS package manager (v0 shell engine).
#
# Source-based, yay-style: ships no binaries. A recipe (.ks) names an upstream
# tarball + a build() block; kix fetches, verifies, builds into a staging root,
# records the installed file list, then merges it onto / so removal stays exact.
#
# Recipes are a constrained, declarative subset that is ALSO valid bash, so this
# sh engine just `source`s them today and a future Krypton-written engine can
# parse the same files unchanged. Keep that contract: recipes set name/version/
# source/sha256 and a build() that calls `run`. Nothing else.
set -euo pipefail

# --- config (override via env) -------------------------------------------------
KIX_ROOT="${KIX_ROOT:-/var/lib/kix}"
KIX_TREE="${KIX_TREE:-$KIX_ROOT/tree}"          # recipe tree (git checkout)
KIX_DB="${KIX_DB:-$KIX_ROOT/db}"                # installed-package manifests
KIX_CACHE="${KIX_CACHE:-/var/cache/kix/src}"    # downloaded tarballs
KIX_WORK="${KIX_WORK:-/tmp/kix-build}"          # scratch build dir
KIX_TREE_URL="${KIX_TREE_URL:-https://github.com/t3m3d/kix-tree.git}"
DESTDIR_ROOT="${KIX_INSTALL_ROOT:-/}"           # where merged files land

c_msg='\033[1;35m'; c_ok='\033[1;32m'; c_warn='\033[1;33m'; c_err='\033[1;31m'; c_0='\033[0m'
msg()  { printf "${c_msg}[kix]${c_0} %s\n" "$*"; }
ok()   { printf "${c_ok}[kix]${c_0} %s\n" "$*"; }
warn() { printf "${c_warn}[kix:warn]${c_0} %s\n" "$*" >&2; }
die()  { printf "${c_err}[kix:fail]${c_0} %s\n" "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "must run as root (writes $DESTDIR_ROOT)"; }
mkdirs()    { mkdir -p "$KIX_TREE" "$KIX_DB" "$KIX_CACHE"; }

# --- recipe sandbox ------------------------------------------------------------
# `run` is the only verb a recipe build() may call. It logs then executes the
# command string with the staging root exported as $PKGROOT. Same surface the
# Krypton engine will implement, so recipes never have to change.
run() { printf '    %s\n' "$*"; eval "$*"; }

recipe_path() {
    local p="$KIX_TREE/$1/recipe.ks"
    [ -f "$p" ] || die "no recipe for '$1' (try: kix sync)"
    printf '%s\n' "$p"
}

# Load a recipe's metadata into the current shell. Caller runs this in a subshell
# so name/version/build() never leak between packages.
load_recipe() {
    name=''; version=''; source=''; sha256=''
    unset -f build 2>/dev/null || true
    # shellcheck disable=SC1090
    . "$(recipe_path "$1")"
    [ -n "$name" ]    || die "$1: recipe missing name"
    [ -n "$version" ] || die "$1: recipe missing version"
    [ -n "$source" ]  || die "$1: recipe missing source"
    declare -F build >/dev/null || die "$1: recipe missing build()"
}

# --- fetch + verify ------------------------------------------------------------
fetch() {
    local url="$1" out="$2"
    [ -f "$out" ] && { msg "cached $(basename "$out")"; return; }
    msg "fetch $url"
    if command -v curl >/dev/null; then
        curl -fL --retry 3 -o "$out.part" "$url"
    else
        wget -O "$out.part" "$url"
    fi
    mv "$out.part" "$out"
}

verify() {
    local file="$1" want="$2"
    if [ -z "$want" ]; then
        warn "no sha256 for $(basename "$file") — recipe should pin one"
        return
    fi
    local got
    got=$(sha256sum "$file" | cut -d' ' -f1)
    [ "$got" = "$want" ] || die "sha256 mismatch for $(basename "$file")
  want $want
  got  $got"
    ok "sha256 ok"
}

# --- commands ------------------------------------------------------------------
cmd_sync() {
    mkdirs
    if [ -d "$KIX_TREE/.git" ]; then
        msg "updating recipe tree"
        git -C "$KIX_TREE" pull --ff-only
    else
        msg "cloning recipe tree from $KIX_TREE_URL"
        rmdir "$KIX_TREE" 2>/dev/null || true
        git clone "$KIX_TREE_URL" "$KIX_TREE"
    fi
    ok "tree synced"
}

installed_version() {
    local v="$KIX_DB/$1/version"
    [ -f "$v" ] && cat "$v" || return 1
}

cmd_install() {
    need_root; mkdirs
    [ $# -ge 1 ] || die "usage: kix install <pkg>..."
    for pkg in "$@"; do _install_one "$pkg"; done
}

_install_one() (
    local pkg="$1"
    load_recipe "$pkg"

    if cur=$(installed_version "$pkg" 2>/dev/null); then
        [ "$cur" = "$version" ] && { ok "$pkg-$version already installed"; return; }
        msg "upgrading $pkg $cur -> $version"
    else
        msg "installing $pkg-$version"
    fi

    local tarball="$KIX_CACHE/$(basename "$source")"
    fetch "$source" "$tarball"
    verify "$tarball" "$sha256"

    rm -rf "$KIX_WORK"; mkdir -p "$KIX_WORK"
    tar -C "$KIX_WORK" -xf "$tarball"
    local srcdir
    srcdir=$(find "$KIX_WORK" -mindepth 1 -maxdepth 1 -type d | head -1)
    [ -n "$srcdir" ] || die "$pkg: tarball had no top-level dir"

    local stage="$KIX_WORK/.stage"
    mkdir -p "$stage"
    export PKGROOT="$stage"

    msg "build $pkg"
    ( cd "$srcdir" && build )

    # Record the file manifest from the staging root, then merge onto the system.
    local dbdir="$KIX_DB/$pkg"
    mkdir -p "$dbdir"
    ( cd "$stage" && find . \( -type f -o -type l \) | sed 's|^\.||' ) > "$dbdir/files"
    printf '%s\n' "$version" > "$dbdir/version"

    msg "merge -> $DESTDIR_ROOT ($(wc -l < "$dbdir/files") files)"
    tar -C "$stage" -cf - . | tar -C "$DESTDIR_ROOT" -xf -

    ok "installed $pkg-$version"
)

cmd_remove() {
    need_root
    [ $# -ge 1 ] || die "usage: kix remove <pkg>..."
    for pkg in "$@"; do
        local dbdir="$KIX_DB/$pkg"
        [ -d "$dbdir" ] || { warn "$pkg not installed"; continue; }
        msg "removing $pkg"
        # Files first (reverse order), then prune now-empty dirs they lived in.
        tac "$dbdir/files" | while read -r f; do
            [ -n "$f" ] || continue
            rm -f "${DESTDIR_ROOT%/}/$f" 2>/dev/null || true
        done
        sed 's|/[^/]*$||' "$dbdir/files" | sort -ru | while read -r d; do
            rmdir "${DESTDIR_ROOT%/}/$d" 2>/dev/null || true
        done
        rm -rf "$dbdir"
        ok "removed $pkg"
    done
}

cmd_upgrade() {
    need_root; mkdirs
    [ -d "$KIX_DB" ] || { ok "nothing installed"; return; }
    local any=0
    for dbdir in "$KIX_DB"/*/; do
        [ -d "$dbdir" ] || continue
        local pkg cur new
        pkg=$(basename "$dbdir")
        cur=$(cat "$dbdir/version")
        new=$( ( load_recipe "$pkg"; printf '%s' "$version" ) 2>/dev/null ) || { warn "$pkg: no recipe in tree"; continue; }
        if [ "$cur" != "$new" ]; then
            msg "$pkg $cur -> $new"; _install_one "$pkg"; any=1
        fi
    done
    [ "$any" = 1 ] || ok "everything up to date"
}

cmd_search() {
    [ $# -ge 1 ] || die "usage: kix search <term>"
    [ -d "$KIX_TREE" ] || die "no tree (run: kix sync)"
    for d in "$KIX_TREE"/*/; do
        local p="$d/recipe.ks"; [ -f "$p" ] || continue
        local n=$(basename "$d")
        if printf '%s' "$n" | grep -qi "$1"; then
            local v=$( ( load_recipe "$n"; printf '%s' "$version" ) 2>/dev/null || echo '?')
            printf '%-20s %s\n' "$n" "$v"
        fi
    done
}

cmd_list() {
    [ -d "$KIX_DB" ] || { ok "nothing installed"; return; }
    for d in "$KIX_DB"/*/; do
        [ -d "$d" ] || continue
        printf '%-20s %s\n' "$(basename "$d")" "$(cat "$d/version")"
    done
}

cmd_info() {
    [ $# -ge 1 ] || die "usage: kix info <pkg>"
    ( load_recipe "$1"
      printf 'name     %s\nversion  %s\nsource   %s\nsha256   %s\n' \
        "$name" "$version" "$source" "${sha256:-<none>}"
      if v=$(installed_version "$1" 2>/dev/null); then echo "installed $v"; else echo "installed no"; fi )
}

usage() {
    cat <<EOF
kix — KryptOS package manager

  kix sync               update the recipe tree
  kix install <pkg>...   build + install from source
  kix remove  <pkg>...   remove tracked files
  kix upgrade            rebuild packages with newer recipes
  kix search  <term>     search recipe names
  kix list               list installed packages
  kix info    <pkg>      show recipe details

Source-based: recipes live in $KIX_TREE, upstream tarballs cache in $KIX_CACHE.
EOF
}

main() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        sync)    cmd_sync "$@";;
        install|in|add) cmd_install "$@";;
        remove|rm|del)  cmd_remove "$@";;
        upgrade|up)     cmd_upgrade "$@";;
        search|se)      cmd_search "$@";;
        list|ls)        cmd_list "$@";;
        info)           cmd_info "$@";;
        ''|-h|--help|help) usage;;
        *) die "unknown command: $sub (try: kix help)";;
    esac
}
main "$@"
