#!/bin/bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/kryptos-ipc" ]; then
    exec "$DIR/kryptos-ipc" toggleCalendar
fi
if [ -x "$HOME/.config/quickshell/scripts/kryptos-ipc" ]; then
    exec "$HOME/.config/quickshell/scripts/kryptos-ipc" toggleCalendar
fi
# Legacy dev-tree fallback
if [ -x "$HOME/Projects/kryptos-shell/quickshell/scripts/kryptos-ipc" ]; then
    exec "$HOME/Projects/kryptos-shell/quickshell/scripts/kryptos-ipc" toggleCalendar
fi
echo "kryptos-ipc not found" >&2
exit 1
