#!/bin/sh
# ly launches this straight from inittab, without a login shell, so HOME and
# PATH arrive absent or minimal. A PATH without /usr/bin makes the root check
# below fail with "id: command not found", and Hyprland aborts without HOME
# ("Neither HOME nor XDG_CONFIG_HOME are set"), so set both before anything.
export HOME="${HOME:-/root}"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
[ "$(id -u)" -eq 0 ] || { echo "KryptOS: start-hypr currently requires root." >&2; exit 1; }
command -v Hyprland >/dev/null 2>&1 || { echo "KryptOS: Hyprland is not installed." >&2; exit 1; }
STARTUP_TIMEOUT=${STARTUP_TIMEOUT:-30}
case "$STARTUP_TIMEOUT" in ''|*[!0-9]*|0) echo "KryptOS: STARTUP_TIMEOUT must be positive seconds." >&2; exit 1 ;; esac
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"
# Hold lock for the session; util-linux provides flock in the base image.
command -v flock >/dev/null 2>&1 || { echo "KryptOS: missing flock." >&2; exit 1; }
exec 9>"$XDG_RUNTIME_DIR/kryptos-hypr.lock"
flock -n 9 || { echo "KryptOS: desktop session already running." >&2; exit 1; }
# Never mistake another compositor's socket for this launcher's readiness.
for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ ! -S "$socket" ] || { echo "KryptOS: existing Wayland socket $socket; stop that session first." >&2; exit 1; }
done
export XDG_SESSION_TYPE=wayland
export LIBSEAT_BACKEND=builtin
# Give the session a bus of its own. Hyprland publishes WAYLAND_DISPLAY and
# friends through dbus-update-activation-environment; without an address that
# call fails and no portal or notification daemon can be activated. Images
# built without dbus simply skip this.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-daemon >/dev/null 2>&1; then
    if bus_address=$(dbus-daemon --session --fork --print-address=1 2>/dev/null); then
        [ -z "$bus_address" ] || export DBUS_SESSION_BUS_ADDRESS="$bus_address"
    fi
fi

DRM_CARD=
DRM_DRIVER=
for card in /sys/class/drm/card[0-9]*; do
    [ -e "$card/device" ] || continue
    driver=$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)")
    if [ "$driver" = amdgpu ]; then
        DRM_CARD="/dev/dri/${card##*/}"
        DRM_DRIVER="$driver"
        break
    fi
    if [ -z "$DRM_CARD" ]; then
        DRM_CARD="/dev/dri/${card##*/}"
        DRM_DRIVER="$driver"
    fi
done
[ -n "$DRM_CARD" ] || DRM_CARD=/dev/dri/card0
if [ ! -e "$DRM_CARD" ]; then
    echo "KryptOS: no DRM device found; desktop not started." >&2
    exit 1
fi
export AQ_DRM_DEVICES="$DRM_CARD"

case "$DRM_DRIVER" in
    hyperv_drm)
        export WLR_NO_HARDWARE_CURSORS=1
        export WLR_RENDERER_ALLOW_SOFTWARE=1
        # Hyper-V has no render node. Mesa 24.3+ can select its KMS software
        # path automatically; forcing zink or kms_swrast makes EGL reject it.
        unset MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER LIBGL_ALWAYS_SOFTWARE
        ;;
    virtio_gpu|virtio-pci|bochs_drm)
        export WLR_NO_HARDWARE_CURSORS=1
        export WLR_RENDERER_ALLOW_SOFTWARE=1
        # zink renders through Vulkan, so it needs the loader. Images built
        # without it must take Mesa's KMS software path instead of letting EGL
        # discover the failure mid-startup.
        if [ -e /usr/lib/libvulkan.so.1 ]; then
            export MESA_LOADER_DRIVER_OVERRIDE=zink
            export GALLIUM_DRIVER=zink
            case "$(uname -m)" in
                aarch64|arm64) LVP_ICD=/usr/share/vulkan/icd.d/lvp_icd.aarch64.json ;;
                x86_64)        LVP_ICD=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json ;;
                *)             LVP_ICD=$(ls /usr/share/vulkan/icd.d/lvp_icd*.json 2>/dev/null | head -1) ;;
            esac
            [ -n "${LVP_ICD:-}" ] && [ -f "$LVP_ICD" ] && export VK_ICD_FILENAMES="$LVP_ICD"
        else
            # No Vulkan loader: leave driver selection to Mesa, which falls
            # back to kms_swrast on its own. Forcing the override here pairs
            # kms_swrast with the wrong gallium driver and every EGL client
            # (including Qt's wayland plugin) then fails to create a config.
            unset MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER
        fi
        ;;
    amdgpu)
        export LIBVA_DRIVER_NAME=radeonsi
        ;;
esac
echo "KryptOS: starting Hyprland on $DRM_CARD (driver ${DRM_DRIVER:-unknown})."
# v0 runs the VM as root; Hyprland blocks root unless this flag is passed.
Hyprland --i-am-really-stupid > /var/log/hypr.log 2>&1 &
hypr_pid=$!
cleanup() {
    kill "$hypr_pid" 2>/dev/null || true
    wait "$hypr_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
tries=0
ready=0
while kill -0 "$hypr_pid" 2>/dev/null && [ "$tries" -lt "$STARTUP_TIMEOUT" ]; do
    for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
        if [ -S "$socket" ]; then
            ready=1
            break
        fi
    done
    [ "$ready" -eq 1 ] && break
    sleep 1
    tries=$((tries + 1))
done
if ! kill -0 "$hypr_pid" 2>/dev/null; then
    wait "$hypr_pid"
    status=$?
    echo "KryptOS: Hyprland exited with status $status. See /var/log/hypr.log; collect report with kryptos-diagnose." >&2
    exit "$status"
fi
if [ "$ready" -ne 1 ]; then
    echo "KryptOS: Hyprland startup timed out. See /var/log/hypr.log; collect report with kryptos-diagnose." >&2
    kill "$hypr_pid" 2>/dev/null || true
    wait "$hypr_pid" 2>/dev/null || true
    exit 1
fi
wait "$hypr_pid"
