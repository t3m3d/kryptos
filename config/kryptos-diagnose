#!/usr/bin/env bash
# Local-only boot/graphics/network report. Does not change configuration.
set -uo pipefail
umask 077
OUT="${1:-/tmp/kryptos-diagnose-$(date +%Y%m%d-%H%M%S)-$$.txt}"
# Refuse overwrite or symlink targets, including in shared /tmp.
set -o noclobber
exec 3>"$OUT" || { echo "cannot create report: $OUT" >&2; exit 1; }
section() { printf '\n=== %s ===\n' "$*" >&3; }
run() {
    if command -v "$1" >/dev/null 2>&1; then
        "$@" >&3 2>&3 || printf '[unavailable or failed: %s]\n' "$*" >&3
    else
        printf '[missing: %s]\n' "$1" >&3
    fi
}
section 'System / boot'
run date -u
run uname -a
[ ! -r /etc/os-release ] || cat /etc/os-release >&3
[ ! -r /proc/cmdline ] || cat /proc/cmdline >&3
if [ -d /sys/firmware/efi ]; then echo 'Boot mode: UEFI' >&3; else echo 'Boot mode: BIOS or EFI sysfs unavailable' >&3; fi
section 'Graphics devices'
run lspci -nnk
for card in /sys/class/drm/card[0-9]*; do
    [ -e "$card/device" ] || continue
    printf '%s driver=%s\n' "${card##*/}" "$(readlink -f "$card/device/driver" 2>/dev/null)" >&3
    for status in "$card"-*/status; do
        [ ! -r "$status" ] || { printf '%s: ' "$status" >&3; cat "$status" >&3; }
    done
done
run ls -l /dev/dri
section 'Network addresses / routes / DNS'
run ip -br addr
run ip route
[ ! -r /etc/resolv.conf ] || cat /etc/resolv.conf >&3
run dhcpcd --version
section 'Desktop processes'
run pgrep -a -x Hyprland
run pgrep -a -x quickshell
run pgrep -a -x qs
section 'Hyprland log (last 120 lines)'
[ ! -r /var/log/hypr.log ] || tail -120 /var/log/hypr.log >&3
section 'Kernel messages (last 200 lines)'
if command -v dmesg >/dev/null 2>&1; then dmesg 2>&1 | tail -200 >&3; fi
exec 3>&-
printf 'Saved local report: %s\n' "$OUT"
